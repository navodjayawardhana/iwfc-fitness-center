@startuml use-cases
title FitPulse – actors and use cases
!pragma layout smetana
left to right direction
skinparam shadowing false
skinparam defaultFontName Arial

actor Administrator as Admin
actor Instructor as Inst
actor Member as Mem

rectangle "FitPulse" {
  usecase "Sign in / sign out" as UC0
  usecase "Manage equipment\n(add, edit, deactivate)" as UC1
  usecase "Manage user accounts" as UC2
  usecase "Assign and update\nmaintenance requests" as UC3
  usecase "View maintenance log\nand alerts" as UC4
  usecase "Schedule sessions\n(single or weekly)" as UC5
  usecase "Log equipment usage" as UC6
  usecase "Report a fault" as UC7
  usecase "Send session reminders" as UC8
  usecase "View available sessions" as UC9
  usecase "Book / cancel a session" as UC10
  usecase "Receive notifications" as UC11
}

Admin --> UC0
Admin --> UC1
Admin --> UC2
Admin --> UC3
Admin --> UC4
Admin --> UC8
Admin --> UC9
Admin --> UC11
Inst --> UC0
Inst --> UC5
Inst --> UC6
Inst --> UC7
Inst --> UC8
Inst --> UC9
Inst --> UC11
Mem --> UC0
Mem --> UC9
Mem --> UC10
Mem --> UC11
@enduml
